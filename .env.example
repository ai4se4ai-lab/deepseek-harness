# Copy to .env and fill in real values. Never commit .env — it is gitignored.
# See deploy/README.md for what each variable does and where it is documented
# in the application source.

# --- Required: outbound calls to the DeepSeek API (packages/llm/llm-deepseek) ---
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek endpoint (defaults to the public API).
# DEEPSEEK_BASE_URL=

# Optional: override the DeepSeek web-search endpoint, if used.
# DEEPSEEK_SEARCH_BASE_URL=

# --- Required in the portal deployment: the public authority NGINX presents ---
# The container's /api DNS-rebinding fence (packages/client/connection) only
# accepts requests whose Host header is loopback or in this list. Without it,
# every request proxied through NGINX is refused with 403.
DSH_TRUSTED_HOST=comp370.soc.ufv.ca

# Internal listen port inside the container (docker-compose.yml exposes this
# on the comp370 network; it is never published to the host in production).
DSH_WEB_PORT=3080
