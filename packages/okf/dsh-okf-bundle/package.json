{
  "name": "@mindportalix/dsh-okf-bundle",
  "description": "ctx.okf — per-tenant Open Knowledge Format bundle service: traverse, read, and write concepts under $DSH_HOME/tenants/<tenantId>/knowledge, regenerating index.md / log.md.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@mindportalix/dsh-okf-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@mindportalix/dsh-tenant-context": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
